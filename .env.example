APP_NAME="Certify LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Docker Compose プロジェクト名 (親ディレクトリが日本語のため明示)
COMPOSE_PROJECT_NAME=certify-lms

# Sail ports (Laravel/Sail 慣習に揃える: web=8000, pma=8080, db=3306, mailpit=8025)
# VITE のみ BookShelf=5173 と衝突するため 5174 に逃がす
APP_PORT=8000
VITE_PORT=5174

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=certify_lms
DB_USERNAME=sail
DB_PASSWORD=password

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# 通知・メール配信を DB キューでバックグラウンド処理する(T-A-05)。
# worker: php artisan queue:work database --tries=3
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# CORS (Sanctum Cookie 認証で別オリジン FE を許可する場合は具体的なオリジンをカンマ区切りで指定)
CORS_ALLOWED_ORIGINS=http://localhost:8000

# ---------------------------------------------------------------------------
# 外部 API 連携 (Advance フェーズ機能)
#
# 本プロジェクトは開発・テストを外部 API のモック(テストは Http::fake() /
# サービスのスタブ差し替え)で完結させているため、以下は未設定でも起動・テストは通る。
# 未設定時の挙動:
#   - Gemini(AI相談)   : GEMINI_API_KEY 空だと送信時に status=error(画面は動く)
#   - Google Calendar  : 未連携/失敗時はイベント連携をスキップし空き判定にフォールバック(面談機能は動く)
#   - Stripe(追加面談購入): 未設定だと Checkout セッション作成に失敗する(購入導線のみ利用不可)
# 実運用で各機能を有効化する手順は README「外部 API 連携の状態」を参照。
# ---------------------------------------------------------------------------

# Gemini AI (S-A-02) — 未設定なら AI 相談は status=error を返す
GEMINI_API_KEY=
# 任意(既定値あり): モデル / エンドポイント
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta

# Google Calendar (S-A-01) — 未設定ならカレンダー連携をスキップ(面談機能自体は動く)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Stripe (S-A-03) — 未設定なら追加面談購入(Checkout)のみ利用不可
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
